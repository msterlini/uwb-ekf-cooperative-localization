<?xml version="1.0"?>
<sdf version="1.6">
  <model name="overview_camera">
    <static>true</static>
    <link name="link">
      <!-- Pose in the link, so that it doesn't depend on the pose given when the model is spawned -->
      <pose>0.3 -6.2 10 0 1.0 1.5708</pose>
      <sensor name="overview_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>/overview_camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>960</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>40</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
