<?xml version="1.0"?>
<sdf version="1.6">
  <model name="overview_camera">
    <static>true</static>
    <pose>0.3 -6.2 10 0 1.0 1.5708</pose>
    <link name="link">
      <sensor name="overview_camera" type="camera">
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>960</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>40</far>
          </clip>
        </camera>
        <plugin name="overview_camera_controller" filename="libgazebo_ros_camera.so">
          <cameraName>overview_camera</cameraName>
          <frameName>overview_camera</frameName>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
